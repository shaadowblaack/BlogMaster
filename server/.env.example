# ─── Server ───────────────────────────────────────────────
# MongoDB connection string (use mongodb+srv:// for Atlas)
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=your-mongodb-connection-string-here

# Port the Express server listens on
PORT=5000

# Admin credentials for the `/api/auth/login` endpoint
# Set ADMIN_USERNAME and ADMIN_PASSWORD in your deployment environment
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Set to 'true' in production (HTTPS) so cookies use the Secure flag
SESSION_COOKIE_SECURE=true

# Set to 'production' in deployment
NODE_ENV=production
